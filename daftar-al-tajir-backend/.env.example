# ============ Application ============
APP_NAME=Daftar-Al-Tajir
APP_ENV=production
DEBUG=False

# ============ Database ============
# Neon PostgreSQL - Render auto-provides DATABASE_URL
# Neon format: postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# System auto-converts: postgresql:// → postgresql+asyncpg://, sslmode → ssl
DATABASE_URL=postgresql://YOUR_NEON_USER:YOUR_NEON_PASS@ep-xxx.region.aws.neon.tech/daftar_tajir?sslmode=require
DATABASE_URL_SYNC=postgresql://YOUR_NEON_USER:YOUR_NEON_PASS@ep-xxx.region.aws.neon.tech/daftar_tajir?sslmode=require

# ============ JWT - CHANGE THIS IN PRODUCTION! ============
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7

# ============ Telegram Bot ============
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_ADMIN_CHAT_ID=YOUR_ADMIN_CHAT_ID
ADMIN_PHONE=0900000000
ADMIN_PASSWORD=your_secure_admin_password

# ============ OCR ============
TESSERACT_LANG=eng+ara

# ============ Bank Account Info ============
BANK_ACCOUNT_NUMBER=YOUR_BANK_ACCOUNT_NUMBER
BANK_ACCOUNT_NAME=YOUR_BANK_ACCOUNT_NAME

# ============ Subscription ============
SUBSCRIPTION_PRICE_PER_MONTH=10000
FIRST_MONTH_FREE=True

# ============ CORS ============
CORS_ORIGINS=["https://your-frontend.onrender.com"]

# ============ Upload ============
UPLOAD_DIR=uploads/receipts
MAX_UPLOAD_SIZE_MB=10
